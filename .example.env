#####
##### podverse-api
#####

# NOTE:
# Use lowercase true to enable properties.
# Leave value blank or comment out to disable properties.

#####
##### App / General
#####

NODE_ENV=development
LOG_LEVEL=info

API_PORT=1234
API_PREFIX=/api
API_VERSION=/v2

AUTH_JWT_SECRET=your-secret-whatever

USER_AGENT=Podverse/API-2

# Use the public facing domain, not the internal docker network ip address.
COOKIE_DOMAIN=localhost
COOKIE_IS_SECURE=

#####
##### Postgres
#####

# LOCAL
DB_HOST=localhost
DB_PORT=5111
DB_READ_USERNAME=
DB_READ_PASSWORD=
DB_READ_WRITE_USERNAME=
DB_READ_WRITE_PASSWORD=
DB_DATABASE=postgres
DB_SSL_CONNECTION=

#####
##### Auth/Membership
#####

EMAIL_VERIFICATION_TOKEN_EXPIRATION=31540000
EMAIL_CHANGE_VERIFICATION_TOKEN_EXPIRATION=31540000
RESET_PASSWORD_TOKEN_EXPIRATION=86400
FREE_TRIAL_EXPIRATION= 2592000
PREMIUM_MEMBERSHIP_EXPIRATION=31540000
PREMIUM_MEMBERSHIP_COST=5
RESET_PASSWORD_PAGE_PATH=/reset-password?token=
VERIFY_EMAIL_PAGE_PATH=/verify-email?token=
EMAIL_CHANGE_VERIFICATION_PAGE_PATH=/verify-email-change?token=

#####
##### Website related
#####
### NOTE: these are for the *public facing* IP addresses,
### not the internal Docker service network or private IP addresses.

WEBSITE_PROTOCOL=
WEBSITE_DOMAIN=

#####
##### Email template
#####
### These are used in the templates of the auth related emails we send.

EMAIL_BRAND_COLOR="#2968B1"
EMAIL_HEADER_IMAGE_URL=https://podverse.fm/images/podverse-logo-white.png
LEGAL_NAME=Podverse LLC
LEGAL_ADDRESS=Chicago, IL, USA
SOCIAL_FACEBOOK_IMAGE_URL=https://podverse.fm/images/social-facebook-128x128.png
SOCIAL_FACEBOOK_PAGE_URL=https://facebook.com/podverse
SOCIAL_GITHUB_IMAGE_URL=https://podverse.fm/images/social-github-128x128.png
SOCIAL_GITHUB_PAGE_URL=https://github.com/podverse
SOCIAL_TWITTER_IMAGE_URL=https://podverse.fm/images/social-twitter-128x128.png
SOCIAL_TWITTER_PAGE_URL=https://twitter.com/podverse

#####
##### Mailer
#####

MAILER_DISABLED=1
MAILER_HOST=
MAILER_PORT=
MAILER_SERVICE=
MAILER_USERNAME=
MAILER_PASSWORD=
MAILER_FROM=

#####
##### QA
#####
# DOTENVX_LOG=false # set to false for qa tests